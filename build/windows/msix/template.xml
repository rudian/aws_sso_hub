<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="aws-sso-hub"
        Arguments=""
        InstallLocation="C:\Program Files\AWS SSO Hub\AWS SSO Hub">
    </Installer>
    <PackageInformation
        PackageName="AWS SSO Hub"
        PackageDisplayName="AWS SSO Hub"
        PublisherName="CN=rudian"
        PublisherDisplayName="rudian"
        Version="0.0.1.0"
        PackageDescription="AWS IAM Identity Center and CodeCommit helper">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rudian.awsssohub"
                Description="AWS IAM Identity Center and CodeCommit helper"
                DisplayName="AWS SSO Hub"
                ExecutableName="aws-sso-hub"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AWS SSO Hub</DisplayName>
            <PublisherDisplayName>rudian</PublisherDisplayName>
            <Description>AWS IAM Identity Center and CodeCommit helper</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="aws-sso-hub.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
