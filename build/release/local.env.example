# Copy to build/release/local.env (git-ignored) and fill in. Plain shell assignments.
# Everything here may also come from the environment. Nothing in this file is a secret:
# the notary credentials live in the login keychain under the profile name below,
# the signing certificate lives in the login keychain, the ed25519 key is a file you keep elsewhere.

# Full name of the "Developer ID Application" identity, as `security find-identity -v -p codesigning` prints it.
CODEPASS_SIGN_IDENTITY=""
# Team ID the updater pins (the OU of the certificate).
CODEPASS_TEAM_ID=""
# Name of the notarytool keychain profile (xcrun notarytool store-credentials <name> ...).
CODEPASS_NOTARY_PROFILE=""
# The current ed25519 private key (hex file, mode 0600) and its public key (required for a real release).
CODEPASS_SIGNING_KEY_FILE=""
CODEPASS_EXPECT_PUBKEY=""
# Target repository for the upload, owner/name.
CODEPASS_RELEASE_REPO=""

# Optional tool and output locations.
# WAILS3=/path/to/wails3
# GH=/path/to/gh
# CODEPASS_OUT_DIR=/path/outside/the/repository
# NOTARY_TIMEOUT=30m
